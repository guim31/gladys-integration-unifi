{
  "manifest_version": 1,
  "type": "device",
  "name": "UniFi Network",
  "description": {
    "en": "Ubiquiti UniFi integration for UCG Fiber, UDM, Switches, Access Points and network presence tracking.",
    "fr": "Intégration Ubiquiti UniFi pour UCG Fiber, UDM, Switches, Points d'accès et détection de présence."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-integration-unifi:1.0.0",
  "gladys_version": ">=4.84.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-integration-unifi/main/cover.png",
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": { "en": "UniFi OS Connection", "fr": "Connexion UniFi OS" },
      "description": {
        "en": "Enter the local IP address of your UniFi Cloud Gateway (UCG Fiber, UDM, Cloud Key) and authentication method.",
        "fr": "Entrez l'adresse IP locale de votre Gateway UniFi (UCG Fiber, UDM, Cloud Key) et le mode d'authentification."
      }
    },
    {
      "key": "unifi_host",
      "type": "text",
      "label": { "en": "IP Address / Hostname", "fr": "Adresse IP / Hôte" },
      "description": {
        "en": "IP address of your UniFi OS console (e.g. 192.168.1.1).",
        "fr": "Adresse IP de votre console UniFi OS (ex: 192.168.1.1)."
      },
      "required": true,
      "default": "192.168.1.1"
    },
    {
      "key": "unifi_port",
      "type": "number",
      "label": { "en": "Port", "fr": "Port" },
      "required": true,
      "default": 443,
      "min": 1,
      "max": 65535
    },
    {
      "key": "unifi_auth_type",
      "type": "select",
      "label": { "en": "Authentication Method", "fr": "Mode d'authentification" },
      "required": true,
      "default": "api_key",
      "options": [
        {
          "value": "api_key",
          "label": {
            "en": "Local API Key (UniFi OS 3.2+ - Recommended)",
            "fr": "Clé API Locale (UniFi OS 3.2+ - Recommandé)"
          }
        },
        {
          "value": "credentials",
          "label": {
            "en": "Local Username & Password",
            "fr": "Nom d'utilisateur & Mot de passe local"
          }
        }
      ]
    },
    {
      "key": "unifi_api_key",
      "type": "password",
      "label": { "en": "Local API Key", "fr": "Clé API Locale" },
      "description": {
        "en": "API Key generated in UniFi OS > Control Plane > System > API Keys.",
        "fr": "Clé API générée dans UniFi OS > Control Plane > Système > Clés API."
      },
      "required": false
    },
    {
      "key": "unifi_username",
      "type": "text",
      "label": { "en": "Local Username", "fr": "Nom d'utilisateur local" },
      "required": false
    },
    {
      "key": "unifi_password",
      "type": "password",
      "label": { "en": "Local Password", "fr": "Mot de passe local" },
      "required": false
    },
    {
      "key": "unifi_site_id",
      "type": "text",
      "label": { "en": "Site ID", "fr": "ID du Site" },
      "required": true,
      "default": "default"
    },
    {
      "key": "presence_offline_delay",
      "type": "number",
      "label": { "en": "Presence Offline Delay (s)", "fr": "Délai de déconnexion présence (s)" },
      "description": {
        "en": "Inactivity delay before marking a device as absent (prevents deep sleep toggling).",
        "fr": "Délai d'inactivité avant d'indiquer un appareil absent (évite les fauts positifs en veille)."
      },
      "required": false,
      "default": 120,
      "min": 0,
      "max": 3600
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": { "en": "Test UniFi Connection", "fr": "Tester la connexion UniFi" },
      "timeout_seconds": 30
    }
  ]
}
